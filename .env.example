# ===== Growth OS — variáveis de ambiente (referência) =====
# Copie para .env e ajuste.

# --- Infra ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=growthos
POSTGRES_PASSWORD=growthos
POSTGRES_DB=growthos
DATABASE_URL=postgresql://growthos:growthos@localhost:5432/growthos

REDIS_URL=redis://localhost:6379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Modo de operação ---
# design | simulation | approved
# NUNCA mude para "approved" sem autorização explícita e restritiva.
GROWTHOS_MODE=simulation

# --- Pilar 1: Extração ---
LEAD_MAX_VOLUME_PER_DAY=100
ICP_CNAE_ALLOWLIST=6911701,8610101,7020400
ICP_REGION_ALLOWLIST=SP,RJ,MG
ICP_MIN_CAPITAL=50000

# --- Pilar 2: Sequenciador ---
SEQUENCER_JITTER_MIN_MS=15000
SEQUENCER_JITTER_MAX_MS=45000
SEQUENCER_WARMUP_DAY1=10
SEQUENCER_WARMUP_STEP=5
SEQUENCER_WARMUP_CEILING=100
SEQUENCER_BUSINESS_HOURS_START=9
SEQUENCER_BUSINESS_HOURS_END=18
SEQUENCER_MAX_OBJECTION_LOOPS=2

# --- Pilar 3: Agente ---
AGENT_PROVIDER=mock
AGENT_SYSTEM_PROMPT_PATH=./workers/python/src/pilar3/prompts/system.md
AGENT_MAX_MESSAGE_CHARS=250
AGENT_QUALIFY_THRESHOLD=70
AGENT_SANITY_BLOCKLIST=garantido,resultado certo,aprovação garantida,te garanto
AGENT_MAX_SANITY_BLOCKS=2

# --- Pilar 4: Observabilidade ---
HEALTH_CHANNEL_MIN=60
HEALTH_REJECTION_RATE_MAX=5
HEALTH_ALERT_INFO=0.5
HEALTH_ALERT_WARNING=0.8

# --- Agenda (mock) ---
CALENDAR_PROVIDER=mock
CALENDAR_BUSINESS_HOURS_START=9
CALENDAR_BUSINESS_HOURS_END=18
